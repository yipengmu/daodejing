{
  "name": "daodejing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/app.ts",
    "build": "npm run data:build && tsc --noEmit && vite build",
    "build:vercel": "npm run build && esbuild scripts/vercel-api.ts --bundle --platform=node --format=esm --packages=external --outfile=lib/api.runtime.js",
    "data:build": "tsx scripts/build-content.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "dev:account": "tsx scripts/dev-account.ts",
    "test": "tsx scripts/test.ts",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "account:role": "tsx scripts/account-role.ts",
    "audio:denoise": "tsx scripts/audio-denoise.ts"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@daodejing/auth-kit": "*",
    "@electric-sql/pglite": "^0.3.14",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "cos-nodejs-sdk-v5": "^2.14.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "music-metadata": "^12.3.4",
    "pglite-prisma-adapter": "^0.6.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.1",
    "sharp": "^0.35.5",
    "tencentcloud-sdk-nodejs-ses": "^4.1.266",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "overrides": {
    "pglite-prisma-adapter": {
      "@prisma/driver-adapter-utils": "6.19.0"
    }
  }
}
